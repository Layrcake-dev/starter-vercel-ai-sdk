{
  "name": "starter-vercel-ai-sdk",
  "version": "1.0.0",
  "private": true,
  "description": "A Vercel AI SDK starter that finds people, verifies their work emails with Layrcake and drafts a campaign that waits for a person to approve.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --import tsx src/agent.ts",
    "smoke": "node --env-file-if-exists=.env --import tsx src/smoke.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.83",
    "@layrcake/ai-sdk": "^0.1.0",
    "ai": "^7.0.145",
    "layrcake": "^0.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
